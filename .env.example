# Copy to .env and fill in OPENAI_API_KEY — that is the only value you must
# supply. The knowledge base ships pre-loaded, so no football API key is needed
# to run the app.
#
#   cp .env.example .env
#   docker compose up -d

# Required — the agent and the judge both call OpenAI.
OPENAI_API_KEY=

# Postgres. These work as-is; change them if you like.
POSTGRES_USER=wc2026
POSTGRES_PASSWORD=wc2026
POSTGRES_DB=wc2026

# Only needed to rebuild the structured half from source (--profile ingest).
# Under the free 100/day cap a full reload takes two days.
FOOTBALL_API_KEY=

# Optional overrides.
# OPENAI_MODEL=gpt-5.4-mini
# OPENAI_JUDGE_MODEL=gpt-5.4-mini
# MAX_REQUESTS_PER_RUN=90

# Published ports. Change these if something already listens on them — a local
# Postgres on 5432 is the common one. POSTGRES_PORT also tells the host-side
# `uv run` workflow where to connect; containers always use 5432 internally.
# POSTGRES_PORT=5432
# GRAFANA_PORT=3000
# APP_PORT=8501
